* text=auto eol=lf
*.bat eol=crlf

*.v linguist-language=V
*.vv linguist-language=V
*.vsh linguist-language=V
v.mod linguist-language=V
.vdocignore linguist-language=ignore

# The test corpora are C on purpose, and they are the only C here. Counting them
# as one of this repository's languages would say the tree is written in C when
# what it holds is C the compiler is handed rather than C it is built from.
compliance/** linguist-language=ignore
regression/** linguist-language=ignore
goldens/** linguist-language=ignore

# The Dockerfile is how the compiler's image is built, not a language the
# compiler is written in, and GitHub counts it as one: 2,715 bytes against V's
# 3,309,218 in its breakdown, which is the 0.1% that took the language badge off
# 100%. It gets the same marker as the corpora for the same reason, that what a
# file is for here is not a language the tree is written in.
Dockerfile linguist-language=ignore
